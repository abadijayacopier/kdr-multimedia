{
  "name": "camera-mirror-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "tunnel": "ssh -R 80:localhost:8080 nokey@localhost.run",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "electron:start": "electron .",
    "electron:dist": "npm run build && electron-builder --win",
    "cap:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run cap:sync && npx cap open android",
    "mobile:ios": "npm run cap:sync && npx cap open ios",
    "mobile:add": "npx cap add android && npx cap add ios"
  },
  "dependencies": {
    "express": "^4.19.2",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.0",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "localtunnel": "^2.0.2",
    "nodemon": "^3.1.0",
    "vite": "^5.2.11",
    "@capacitor/cli": "^7.4.3"
  },
  "build": {
    "appId": "com.kdrmultimedia.cameramirror",
    "productName": "KDR Multimedia Camera Mirroring",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*","server/**/*","main.cjs","package.json"],
    "win": { "target": ["nsis","portable"], "icon": "public/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KDR Multimedia Camera"
    }
  }
}